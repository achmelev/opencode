{
  // Analog of config.yaml (a Continue.dev config) for opencode.
  //
  // Mapping notes:
  // - Continue's top-level `name`/`version`/`schema` have no opencode equivalent.
  //   The assistant identity instead becomes a named custom agent below ("muster").
  // - Continue's YAML anchors (`requestOptions_common`, `api_common`) are just YAML
  //   reuse; opencode has no anchor mechanism, so the shared apiBase/apiKey/headers
  //   are written once on the provider and inherited by every model under it.
  // - `${{ secrets.X }}` becomes opencode's `{env:X}` substitution syntax.
  // - `verifySsl` has no opencode config equivalent (TLS verification isn't
  //   configurable per-provider) and is intentionally dropped.
  // - A Continue "rule" with `invokable: true` is user-triggered, which matches
  //   opencode's `command` concept (a `/name` slash command) much more closely
  //   than opencode's always-on `instructions` field would.
  // - Instead of a standalone custom agent set as `default_agent`, the built-in
  //   `build`/`plan` agents are customized directly (model/temperature/top_p) —
  //   `build` is already opencode's default primary agent, so no `default_agent`
  //   override is needed.
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "muster-litellm": {
      "name": "Muster LiteLLM Gateway",
      // Any OpenAI-compatible endpoint (like a LiteLLM proxy) uses this npm package.
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:OPENAI_API_BASE_ENV}",
        "apiKey": "{env:OPENAI_API_KEY_ENV}",
        // Shared request headers, equivalent to Continue's `requestOptions_common` anchor.
        "headers": {
          "User-Agent": "continue-dev",
          "x-litellm-customer-id": "Muster GmbH",
          "x-litellm-tags": "continue,ide,dev",
        },
      },
      "models": {
        "Qwen/Qwen3.6-35B-A3B-FP8": {
          "name": "LLMaaS Qwen3.6-35B-A3B FULL-THINK",
          // `limit.output` is the analog of Continue's `defaultCompletionOptions.maxTokens`:
          // it caps the actual `maxOutputTokens` sent on every request for this model.
          // (There's no per-agent output-token cap in opencode, unlike temperature/top_p.)
          "limit": {
            "context": 262144,
            "output": 8192,
          },
          "options": {
            // Provider-specific request body passthrough, equivalent to Continue's
            // `extraBodyProperties.chat_template_kwargs`.
            "chat_template_kwargs": {
              "enable_thinking": true,
            },
          },
        },
      },
    },
  },

  "agent": {
    // Customizes the built-in `build`/`plan` agents in place instead of defining a
    // standalone custom agent — each key here is merged onto the matching built-in's
    // predefined defaults (permissions, description, mode, etc. are all preserved).
    // `temperature`/`top_p` are opencode agent fields (Continue keeps these on the
    // model as `defaultCompletionOptions`).
    "build": {
      "model": "muster-litellm/Qwen/Qwen3.6-35B-A3B-FP8",
      "temperature": 0.2,
      "top_p": 0.8,
    },
    "plan": {
      "model": "muster-litellm/Qwen/Qwen3.6-35B-A3B-FP8",
      "temperature": 0.2,
      "top_p": 0.8,
    },
  },

  "command": {
    // Analog of the invokable "bteaminit" rule. opencode commands are explicitly
    // triggered (e.g. `/agents-md-init`), matching Continue's `invokable: true`
    // rule semantics. `{file:...}` inlines the howto guide directly into the
    // command's prompt instead of telling the model to go read it itself.
    "agents-md-init": {
      "description": "Writing AGENTS.md for a new project",
      "template": "You are starting work on a new Java project. Your first and only task right now is to create the file `AGENTS.md` in the root of the working directory. This file will serve as your \"memory\" for all future sessions on this project. Follow this guide on how to do it:\n\n{file:/prompts/AGENTS_HOWTO.md}",
    },
  },
}
